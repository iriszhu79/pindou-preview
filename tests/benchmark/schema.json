{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pindou.example/benchmark/schema/1.0",
  "title": "Pindou benchmark dataset and annotation v1.0",
  "$defs": {
    "verification": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unreviewed",
            "verified",
            "ambiguous"
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewerKind": {
          "enum": [
            "human",
            "assistant",
            "synthetic-generator",
            "recognizer"
          ]
        },
        "independent": {
          "type": "boolean"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    },
    "crop": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "columns": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "rows",
        "columns"
      ],
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "columns": {
          "type": "integer",
          "minimum": 1
        },
        "crop": {
          "$ref": "#/$defs/crop"
        }
      },
      "required": [
        "rows",
        "columns",
        "crop"
      ],
      "additionalProperties": false
    },
    "cell": {
      "type": "object",
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "occupancy": {
          "enum": [
            "occupied",
            "empty",
            "unknown"
          ]
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "colorCode": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "colorVerification": {
          "$ref": "#/$defs/verification"
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "row",
        "column",
        "occupancy",
        "verification"
      ],
      "additionalProperties": false
    },
    "annotation": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": "1.0"
        },
        "patternId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "verification": {
          "$ref": "#/$defs/verification"
        },
        "grid": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "dimensions": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "$ref": "#/$defs/dimensions"
                    },
                    "verification": {
                      "$ref": "#/$defs/verification"
                    }
                  },
                  "required": [
                    "value",
                    "verification"
                  ],
                  "additionalProperties": false
                },
                "crop": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "$ref": "#/$defs/crop"
                    },
                    "verification": {
                      "$ref": "#/$defs/verification"
                    }
                  },
                  "required": [
                    "value",
                    "verification"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "dimensions"
              ],
              "additionalProperties": false
            }
          ]
        },
        "legend": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/crop"
            },
            "verification": {
              "$ref": "#/$defs/verification"
            }
          },
          "required": [
            "value",
            "verification"
          ],
          "additionalProperties": false
        },
        "palette": {
          "type": "object",
          "properties": {
            "completeness": {
              "enum": [
                "partial",
                "complete"
              ]
            },
            "verification": {
              "$ref": "#/$defs/verification"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verification": {
                    "$ref": "#/$defs/verification"
                  },
                  "quantity": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "verification": {
                        "$ref": "#/$defs/verification"
                      }
                    },
                    "required": [
                      "value",
                      "verification"
                    ],
                    "additionalProperties": false
                  },
                  "swatch": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": "array",
                        "minItems": 3,
                        "maxItems": 3,
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        }
                      },
                      "verification": {
                        "$ref": "#/$defs/verification"
                      }
                    },
                    "required": [
                      "value",
                      "verification"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "code",
                  "verification"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "completeness",
            "verification",
            "entries"
          ],
          "additionalProperties": false
        },
        "mappingPolicy": {
          "type": "object",
          "properties": {
            "value": {
              "type": "object",
              "properties": {
                "maxDistance": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1
                },
                "minMargin": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "maxDistance",
                "minMargin"
              ],
              "additionalProperties": false
            },
            "verification": {
              "$ref": "#/$defs/verification"
            }
          },
          "required": [
            "value",
            "verification"
          ],
          "additionalProperties": false
        },
        "cellCoverage": {
          "enum": [
            "partial",
            "complete"
          ]
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        }
      },
      "required": [
        "schemaVersion",
        "patternId",
        "revision",
        "verification",
        "grid",
        "palette",
        "cellCoverage",
        "cells"
      ],
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "kind": {
          "enum": [
            "real",
            "synthetic"
          ]
        },
        "split": {
          "enum": [
            "development",
            "held-out"
          ]
        },
        "splitHistory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "split": {
                "enum": [
                  "development",
                  "held-out"
                ]
              },
              "at": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "split",
              "at",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "image": {
          "type": "object",
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "original": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "width",
                "height",
                "sha256"
              ],
              "additionalProperties": false
            },
            "provenance": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "original",
                    "repository-screenshot",
                    "conversation-copy",
                    "derived",
                    "synthetic"
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "transformations": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "byteIdentity": {
                  "enum": [
                    "verified",
                    "not-verified",
                    "not-applicable"
                  ]
                }
              },
              "required": [
                "status",
                "source",
                "transformations",
                "byteIdentity"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "file",
            "width",
            "height",
            "sha256",
            "provenance"
          ],
          "additionalProperties": false
        },
        "chart": {
          "type": "object",
          "properties": {
            "brand": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "brand",
            "type"
          ],
          "additionalProperties": false
        },
        "annotation": {
          "type": "string",
          "minLength": 1
        },
        "manualRecovery": {
          "type": "object",
          "properties": {
            "geometry": {
              "$ref": "#/$defs/geometry"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "geometry",
            "source"
          ],
          "additionalProperties": false
        },
        "familyId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        }
      },
      "required": [
        "id",
        "kind",
        "split",
        "splitHistory",
        "image",
        "chart",
        "annotation",
        "familyId"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "datasetId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sample"
      }
    }
  },
  "required": [
    "schemaVersion",
    "datasetId",
    "version",
    "description",
    "samples"
  ],
  "additionalProperties": false
}
